"" SYMLINK: ~/.ideavimrc

"" .ideavimrc - IntellJ IDEs

"" Base Settings
set scrolloff=10
set relativenumber
set showmode
set showcmd

set ignorecase
set smartcase
set incsearch
set hlsearch

set ideajoin
set visualbell

" Use system clipboard
set clipboard+=unnamedplus

" Handlers
sethandler <C-j> n:vim
sethandler <C-j> i:ide
sethandler <C-k> n:vim
sethandler <C-k> i:ide
sethandler <C-h> a:vim
sethandler <C-l> a:vim

let mapleader = " "

"" Plugin Settings
set surround      " cs/ds/ys to change, delete, add surroundings (quotes, brackets, tags)
set nerdtree      " file tree navigation with vim keys
set highlightedyank " highlight objects that have just been yanked
set anyobject     " semantic text objects: aa/ia args, ac/ic class, af/if func, al/il loop, ay/iy conditional, av/iv assignment
set textobj-entire      " vae/vie to select entire file
set exchange            " cx to swap two text objects

" Easymotion settings
set notimeout

" Which-key settings
set which-key
let g:WhichKey_FontSize = 16
let g:WhichKeyDesc_flash = "s Flash search jump"
let g:WhichKey_CommandColor = "#41ead4"
